{
  "schemaVersion": 1,
  "id": "cmk.exe-dev",
  "name": "exe.dev VMs",
  "version": "1.0.0",
  "author": "Christian Kreiling",
  "license": "MIT",
  "description": "Fuzzy-find exe.dev VMs from the Omarchy bar, with keyboard navigation, SSH, and browser access.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "exe.dev",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 60,
      "clickAction": "ssh"
    },
    "schema": [
      {
        "key": "clickAction",
        "type": "enum",
        "label": "Click a VM to open",
        "options": ["ssh", "browser", "details"],
        "defaultValue": "ssh",
        "description": "Mouse click action. Enter always opens VM details from the list; B and S always launch browser and SSH."
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh while open (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      }
    ]
  }
}
